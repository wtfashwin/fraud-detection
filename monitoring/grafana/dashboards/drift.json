{
  "uid": "fraud-input-drift",
  "title": "Fraud input distribution",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": [
    "fraud",
    "input-drift"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Raw input KS statistic (not AUC)",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "fraud_drift_ks",
          "legendFormat": "{{feature}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "KS comparison available (0 means unavailable)",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "fraud_drift_available",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Accepted predictions in shared live window",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "fraud_drift_window_samples",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "KS compares raw input distributions against a bounded training-only reference. Missing reference or fewer than 20 live samples means unavailable. KS > 0.05 sustained for 30 seconds triggers the local alert. This is a distribution alarm, not proof of an AUC decline. [Runbook](https://github.com/wtfashwin/fraud-detection/blob/main/docs/runbooks/PredictionDrift.md)."
      }
    }
  ]
}
